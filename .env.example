# Multimodal Document QA Inference Lab — environment variables
# Copy to .env and edit. All variables are prefixed with MMI_.

# --- Backend defaults ---
# Used when an API request omits the backend / model / quantization fields.
MMI_DEFAULT_BACKEND=mock
MMI_DEFAULT_MODEL=mock-vlm
MMI_DEFAULT_QUANTIZATION=fp16

# Real VLM (used when MMI_DEFAULT_BACKEND=transformers)
MMI_TRANSFORMERS_MODEL_ID=Qwen/Qwen2-VL-2B-Instruct

# --- Document ingestion ---
# Resize the longer edge of every uploaded image to this many pixels.
MMI_MAX_IMAGE_EDGE=1280

# --- Filesystem layout ---
# Relative paths resolve against the repo root.
MMI_DATA_DIR=data
MMI_RESULTS_DIR=results
MMI_SAMPLE_INVOICE_SUBDIR=sample_invoices

# --- Observability ---
MMI_LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins. Empty = CORS middleware disabled.
# Example: MMI_CORS_ORIGINS=http://localhost:3000,https://your-app.example.com
MMI_CORS_ORIGINS=

# --- Streamlit UI ---
# The Streamlit workbench reads this to decide where the FastAPI backend lives.
# Inside docker-compose this is set to http://api:8000 automatically.
MMI_API_URL=http://localhost:8000
